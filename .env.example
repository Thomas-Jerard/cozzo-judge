# Nebius Token Factory API key. The server reads this. It is never sent to the browser.
# Leave it empty to run in mock mode.
NEBIUS_API_KEY=

# Optional. Default is the host that lists these Nemotron models:
# https://api.tokenfactory.nebius.com/v1
# NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1

# Optional default model. Must be one of the ids in lib/models.ts.
# nvidia/nemotron-3-super-120b-a12b is the default.
# NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b

# auto (default) uses live when NEBIUS_API_KEY is set, otherwise mock.
# live fails closed if the key is missing. mock never calls Nebius.
# JUDGE_MODE=auto

# Live scorecards per visitor IP per rolling hour, and per UTC day for everyone.
# Mock scoring is not counted. Counters are in memory on each server instance.
# LIVE_IP_HOURLY_CAP=10
# LIVE_DAILY_CAP=300
